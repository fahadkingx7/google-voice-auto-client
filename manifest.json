{
  "manifest_version": 3,
  "name": "TrucksMate Call Logger",
  "version": "4.9.0",
  "description": "Auto-dialer and call logger for Google Voice, synced to your TrucksMate team dashboard.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://voice.google.com/*", "https://*.supabase.co/*", "https://*.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrucksMate Call Logger",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://voice.google.com/*"],
      "js": ["config.js", "brand.js", "shared.js", "dialer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
